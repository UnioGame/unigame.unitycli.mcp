{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unigame.dev/schemas/unity-cli-mcp/editor-metadata.v1.schema.json",
  "title": "Unity CLI MCP Editor Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "metadata_revision", "project_id", "project_name",
    "project_path", "editor_instance_id", "editor_pid", "editor_started_at_utc",
    "editor_version", "package_version", "pipeline_version", "connection_state",
    "heartbeat_at_utc", "lease_expires_at_utc", "pipeline_descriptor_path",
    "capability_catalog_hash", "tool_count", "is_playing", "is_compiling",
    "compile_errors_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "metadata_revision": { "type": "integer", "minimum": 0 },
    "project_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "project_name": { "type": "string", "minLength": 1 },
    "project_path": { "type": "string", "minLength": 1 },
    "editor_instance_id": { "type": "string", "format": "uuid" },
    "editor_pid": { "type": "integer", "minimum": 1 },
    "editor_started_at_utc": { "type": "string", "format": "date-time" },
    "editor_version": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "connection_state": { "type": "string", "minLength": 1 },
    "heartbeat_at_utc": { "type": "string", "format": "date-time" },
    "lease_expires_at_utc": { "type": "string", "format": "date-time" },
    "pipeline_descriptor_path": { "type": "string", "minLength": 1 },
    "capability_catalog_hash": { "type": "string", "minLength": 1 },
    "tool_count": { "type": "integer", "minimum": 0 },
    "is_playing": { "type": "boolean" },
    "is_compiling": { "type": "boolean" },
    "compile_errors_count": { "type": "integer", "minimum": 0 }
  }
}

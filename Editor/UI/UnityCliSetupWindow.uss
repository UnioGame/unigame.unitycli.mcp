.setup-scroll {
    flex-grow: 1;
}

.page {
    padding: 18px 20px 28px 20px;
    max-width: 1180px;
    min-width: 0;
    align-self: center;
    width: 100%;
}

.hero,
.section-heading-row,
.status-header,
.advanced-row,
.preview-actions,
.configuration-section,
.configuration-actions {
    flex-direction: row;
    align-items: center;
}

.hero,
.section-heading-row,
.status-header,
.advanced-row,
.preview-actions {
    justify-content: space-between;
}

.hero {
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.hero-copy,
.section-heading-copy,
.configuration-copy {
    flex-grow: 1;
    min-width: 0;
}

.hero-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--unity-colors-label);
}

.hero-subtitle,
.section-description,
.card-detail,
.result-details,
.advanced-status,
.empty-detail {
    white-space: normal;
    color: var(--unity-colors-secondary-text);
}

.hero-subtitle {
    font-size: 13px;
    margin-top: 3px;
}

.hero-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
}

.page-status {
    margin-right: 8px;
    color: var(--unity-colors-secondary-text);
}

.section,
.advanced {
    background-color: var(--unity-colors-box-background);
    border-color: var(--unity-colors-border);
    border-width: 1px;
    border-radius: 5px;
    padding: 14px;
    margin-bottom: 10px;
    min-width: 0;
}

.architecture-arrow {
    margin-left: 8px;
    margin-right: 8px;
    color: var(--unity-colors-secondary-text);
}

.section-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.section-description {
    margin-bottom: 9px;
}

.eyebrow {
    font-size: 10px;
    color: var(--unity-colors-secondary-text);
    -unity-font-style: bold;
}

.environment-grid,
.agents-grid,
.editors-grid,
.details-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -4px;
    margin-right: -4px;
}

.environment-card,
.editor-card {
    min-width: 240px;
    flex-basis: 45%;
    flex-grow: 1;
    margin: 4px;
    padding: 10px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 3px;
    border-radius: 3px;
}

.card-title {
    -unity-font-style: bold;
}

.status-pill,
.count-pill {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 7px;
    border-radius: 9px;
    background-color: rgba(128, 128, 128, 0.18);
}

.count-pill {
    color: var(--unity-colors-secondary-text);
}

.status-info {
    color: rgb(92, 178, 239);
    background-color: rgba(72, 158, 222, 0.16);
}

.card-value {
    margin-top: 6px;
    -unity-font-style: bold;
}

.card-detail {
    margin-top: 3px;
    min-height: 30px;
}

.state-ready {
    border-left-color: rgb(55, 166, 104);
}

.state-ready .status-pill,
.status-ready {
    color: rgb(75, 190, 121);
}

.state-warning {
    border-left-color: rgb(218, 158, 46);
}

.state-warning .status-pill,
.status-warning {
    color: rgb(230, 170, 57);
}

.state-missing,
.state-error {
    border-left-color: rgb(210, 76, 76);
}

.state-missing .status-pill,
.state-error .status-pill,
.status-error {
    color: rgb(226, 92, 92);
}

.state-neutral {
    color: var(--unity-colors-secondary-text);
}

.details-grid {
    margin-top: 10px;
}

.detail-cell {
    flex-grow: 1;
    flex-basis: 28%;
    min-width: 190px;
    margin: 4px;
    padding: 8px 9px;
    border-radius: 3px;
    background-color: var(--unity-colors-default-background);
}

.detail-cell-wide {
    flex-basis: 45%;
}

.detail-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--unity-colors-secondary-text);
    margin-bottom: 2px;
}

.detail-value {
    white-space: normal;
}

.selectable-value {
    font-size: 10px;
}

.empty-state {
    align-items: center;
    padding: 18px 12px;
    margin-top: 9px;
    border-color: var(--unity-colors-border);
    border-width: 1px;
    border-radius: 3px;
}

.empty-title {
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.editor-name {
    -unity-font-style: bold;
    font-size: 13px;
}

.editor-path {
    white-space: normal;
    color: var(--unity-colors-secondary-text);
    font-size: 10px;
    margin-top: 3px;
    margin-bottom: 6px;
}

.editor-meta-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.editor-meta {
    min-width: 110px;
    flex-grow: 1;
    flex-basis: 45%;
    margin-top: 4px;
}

.editor-meta-value {
    font-size: 10px;
    white-space: normal;
}

.notices-container {
    margin-top: 8px;
}

.button-primary {
    min-height: 30px;
    padding-left: 16px;
    padding-right: 16px;
    -unity-font-style: bold;
}

.button-secondary,
.button-danger {
    min-height: 24px;
}

.button-danger {
    color: rgb(226, 92, 92);
}

.button-link {
    align-self: flex-start;
    margin-left: -4px;
    margin-top: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--unity-colors-link);
}

.button-install {
    min-width: 92px;
    min-height: 30px;
    margin-top: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-color: rgb(73, 151, 207);
    border-radius: 3px;
    background-color: rgb(47, 123, 178);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.button-install:hover {
    background-color: rgb(58, 142, 201);
    border-color: rgb(91, 176, 232);
}

.button-install:active {
    background-color: rgb(37, 103, 151);
}

.card-actions,
.agent-controls {
    flex-direction: row;
    align-items: center;
}

.install-fallback {
    display: none;
}

.agent-row {
    min-width: 300px;
    flex-basis: 45%;
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 4px;
    padding: 7px 9px;
    background-color: var(--unity-colors-default-background);
    border-radius: 3px;
}

.agent-name {
    min-width: 112px;
    -unity-font-style: bold;
}

.agent-toggle {
    margin-left: 8px;
    margin-right: 4px;
}

.agent-detection {
    color: var(--unity-colors-secondary-text);
    font-size: 10px;
}

.agent-found,
.agent-on {
    color: rgb(75, 190, 121);
}

.agent-integration {
    min-width: 72px;
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
}

.agent-pending {
    color: rgb(72, 158, 222);
}

.agent-conflict {
    color: rgb(230, 170, 57);
}

.agent-toggle-value {
    min-width: 20px;
    font-size: 10px;
    -unity-font-style: bold;
}

.option-toggle {
    margin-top: 2px;
    margin-bottom: 5px;
}

.hidden-technical-value {
    display: none;
}

.server-section {
    padding: 16px;
    border-width: 2px;
    border-color: rgba(67, 160, 105, 0.7);
    background-color: rgba(38, 92, 60, 0.13);
}

.server-heading,
.server-control-card,
.server-summary {
    flex-direction: row;
    align-items: center;
}

.server-heading {
    justify-content: space-between;
}

.server-section-title {
    font-size: 18px;
}

.server-section-description {
    margin-bottom: 7px;
}

.server-status-badge {
    min-width: 96px;
    margin-left: 12px;
    padding: 5px 10px;
    border-radius: 10px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 10px;
}

.server-status-running {
    background-color: rgba(48, 165, 96, 0.24);
    color: rgb(90, 218, 139);
}

.server-status-warning {
    background-color: rgba(218, 158, 46, 0.22);
    color: rgb(241, 184, 70);
}

.server-status-stopped {
    background-color: rgba(120, 120, 120, 0.22);
    color: var(--unity-colors-secondary-text);
}

.server-control-card {
    min-height: 68px;
    padding: 12px;
    border-width: 1px;
    border-color: var(--unity-colors-border);
    border-radius: 5px;
    background-color: var(--unity-colors-default-background);
}

.server-lamp {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 12px;
    border-radius: 8px;
    border-width: 2px;
}

.server-lamp-running {
    background-color: rgb(58, 190, 111);
    border-color: rgb(114, 235, 160);
}

.server-lamp-warning {
    background-color: rgb(218, 158, 46);
    border-color: rgb(245, 196, 94);
}

.server-lamp-stopped {
    background-color: rgb(92, 92, 92);
    border-color: rgb(135, 135, 135);
}

.server-control-copy {
    flex-grow: 1;
    min-width: 180px;
    margin-right: 14px;
}

.server-primary-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.server-primary-detail {
    margin-top: 3px;
    white-space: normal;
    color: var(--unity-colors-secondary-text);
}

.button-server-start,
.button-server-stop {
    min-width: 155px;
    min-height: 36px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-radius: 4px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.button-server-start {
    border-color: rgb(59, 174, 106);
    background-color: rgb(41, 145, 83);
}

.button-server-start:hover {
    background-color: rgb(51, 168, 98);
}

.button-server-stop {
    border-color: rgb(188, 83, 83);
    background-color: rgb(145, 58, 58);
}

.button-server-stop:hover {
    background-color: rgb(169, 69, 69);
}

.server-summary {
    margin-top: 9px;
    padding: 8px 10px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.12);
    flex-wrap: wrap;
}

.server-summary-item {
    min-width: 150px;
    flex-grow: 1;
    margin-right: 12px;
}

.server-summary-value {
    margin-top: 2px;
    -unity-font-style: bold;
}

.server-options {
    margin-top: 8px;
}

.server-options > .unity-foldout__content {
    padding: 7px 10px 3px 18px;
}

.environment-card {
    flex-basis: 28%;
}

.configuration-section {
    justify-content: space-between;
    flex-wrap: wrap;
}

.configuration-copy {
    margin-right: 14px;
}

.configuration-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
}

.configuration-actions > .unity-button {
    min-width: 150px;
    margin-left: 5px;
}

.review-button {
    min-width: 180px;
}

.preview-panel,
.result-panel,
.force-toggle,
.diagnostics-panel {
    display: none;
}

.changes-container {
    margin-top: 2px;
}

.change-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 7px 0;
    border-bottom-color: var(--unity-colors-border);
    border-bottom-width: 1px;
}

.change-kind {
    width: 58px;
    margin-right: 8px;
    font-size: 10px;
    -unity-font-style: bold;
}

.change-create {
    color: rgb(75, 190, 121);
}

.change-update,
.change-process {
    color: rgb(72, 158, 222);
}

.change-remove {
    color: rgb(226, 92, 92);
}

.change-description {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.warnings-container {
    margin-top: 8px;
}

.notice {
    white-space: normal;
    padding: 7px 9px;
    margin-bottom: 4px;
    border-radius: 3px;
}

.notice-warning {
    background-color: rgba(218, 158, 46, 0.16);
    color: rgb(230, 170, 57);
}

.notice-error {
    background-color: rgba(210, 76, 76, 0.14);
    color: rgb(226, 92, 92);
}

.notice-info {
    background-color: rgba(72, 158, 222, 0.13);
    color: rgb(92, 178, 239);
}

.force-toggle {
    margin-top: 8px;
    color: rgb(230, 170, 57);
}

.preview-actions {
    margin-top: 12px;
}

.preview-note {
    flex-grow: 1;
    margin-right: 12px;
    margin-bottom: 0;
}

.result-success {
    border-left-color: rgb(55, 166, 104);
    border-left-width: 4px;
}

.result-error {
    border-left-color: rgb(210, 76, 76);
    border-left-width: 4px;
}

.restart-container {
    margin-top: 7px;
}

.advanced {
    padding-top: 10px;
}

.advanced-group {
    margin-top: 9px;
    padding: 10px;
    background-color: var(--unity-colors-default-background);
    border-radius: 3px;
}

.advanced-row > .unity-button {
    margin-left: 6px;
}

.advanced-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    margin-top: 7px;
}

.diagnostics-field {
    height: 170px;
    margin-top: 7px;
    white-space: normal;
}

.is-busy .button-primary,
.is-busy .button-secondary,
.is-busy .button-danger {
    opacity: 0.65;
}
.compact-section {
    padding-bottom: 14px;
}

.readiness-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.readiness-card {
    min-width: 220px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin: 4px;
    padding: 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(128, 128, 128, 0.35);
    background-color: rgba(80, 80, 80, 0.12);
}

.readiness-copy {
    flex-grow: 1;
    margin-left: 8px;
}

.status-lamp {
    width: 10px;
    height: 10px;
    min-width: 10px;
    border-radius: 5px;
    background-color: rgb(125, 125, 125);
}

.status-lamp-large {
    width: 16px;
    height: 16px;
    min-width: 16px;
    border-radius: 8px;
    margin-right: 10px;
}

.lamp-ready {
    background-color: rgb(54, 184, 96);
}

.lamp-warning {
    background-color: rgb(223, 166, 47);
}

.lamp-error {
    background-color: rgb(211, 76, 76);
}

.official-mcp-card {
    border-left-width: 4px;
    border-left-color: rgb(74, 136, 229);
}

.mcp-card-header {
    flex-direction: row;
    align-items: center;
}

.mcp-card-copy {
    flex-grow: 1;
}

.mcp-result {
    margin-top: 10px;
    margin-bottom: 10px;
    white-space: normal;
}

.button-large {
    min-height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
}

.button-compact {
    min-height: 25px;
    padding-left: 10px;
    padding-right: 10px;
}

.disabled-reason {
    color: rgb(213, 157, 65);
    font-size: 11px;
    white-space: normal;
    margin-top: 3px;
}

.cards-list {
    margin-top: 8px;
}

#agents-container {
    margin-top: 5px;
}

#agents-container .integration-card {
    min-height: 38px;
    margin-bottom: 3px;
    padding: 5px 9px;
}

#agents-container .card-detail {
    min-height: 0;
    margin-top: 1px;
}

.integration-card {
    flex-direction: row;
    align-items: center;
    min-height: 50px;
    margin-bottom: 6px;
    padding: 9px;
    border-width: 1px;
    border-radius: 5px;
    border-color: rgba(128, 128, 128, 0.35);
}

.integration-copy {
    flex-grow: 1;
}

.integration-state {
    margin-right: 10px;
}

.skill-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.skill-card {
    min-width: 240px;
    flex-grow: 1;
    margin: 4px;
    padding: 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(128, 128, 128, 0.35);
}

.skill-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.skill-actions > .unity-button {
    min-width: 92px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.status-verified {
    color: rgb(87, 210, 120);
    background-color: rgba(54, 184, 96, 0.18);
}

.status-testing {
    color: rgb(106, 166, 255);
    background-color: rgba(74, 136, 229, 0.18);
}

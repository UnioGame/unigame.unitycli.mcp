.setup-scroll {
    flex-grow: 1;
}

.page {
    padding: 18px 20px 28px 20px;
    max-width: 1180px;
    min-width: 0;
    align-self: center;
    width: 100%;
}

.hero,
.section-heading-row,
.status-header,
.advanced-row,
.preview-actions,
.configuration-section,
.configuration-actions,
.architecture-strip,
.architecture-step,
.registration-banner,
.broker-card {
    flex-direction: row;
    align-items: center;
}

.hero,
.section-heading-row,
.status-header,
.advanced-row,
.preview-actions,
.registration-banner {
    justify-content: space-between;
}

.hero {
    margin-bottom: 14px;
    flex-wrap: wrap;
}

.hero-copy,
.section-heading-copy,
.configuration-copy,
.step-copy {
    flex-grow: 1;
    min-width: 0;
}

.hero-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--unity-colors-label);
}

.hero-subtitle,
.section-description,
.card-detail,
.result-details,
.advanced-status,
.step-detail,
.empty-detail {
    white-space: normal;
    color: var(--unity-colors-secondary-text);
}

.hero-subtitle {
    font-size: 13px;
    margin-top: 3px;
}

.hero-actions {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
}

.page-status {
    margin-right: 8px;
    color: var(--unity-colors-secondary-text);
}

.section,
.advanced,
.architecture-strip {
    background-color: var(--unity-colors-box-background);
    border-color: var(--unity-colors-border);
    border-width: 1px;
    border-radius: 5px;
    padding: 14px;
    margin-bottom: 10px;
    min-width: 0;
}

.architecture-strip {
    justify-content: space-between;
    padding-top: 11px;
    padding-bottom: 11px;
    flex-wrap: wrap;
}

.architecture-step {
    flex-grow: 1;
    flex-basis: 28%;
    min-width: 180px;
}

.step-number {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    padding-top: 3px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 12px;
    background-color: rgba(72, 158, 222, 0.22);
    color: rgb(92, 178, 239);
}

.step-title {
    -unity-font-style: bold;
}

.step-detail {
    font-size: 10px;
    margin-top: 1px;
}

.architecture-arrow {
    margin-left: 8px;
    margin-right: 8px;
    color: var(--unity-colors-secondary-text);
}

.section-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.section-description {
    margin-bottom: 9px;
}

.eyebrow {
    font-size: 10px;
    color: var(--unity-colors-secondary-text);
    -unity-font-style: bold;
}

.environment-grid,
.agents-grid,
.editors-grid,
.details-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -4px;
    margin-right: -4px;
}

.environment-card,
.editor-card {
    min-width: 240px;
    flex-basis: 45%;
    flex-grow: 1;
    margin: 4px;
    padding: 10px;
    background-color: var(--unity-colors-default-background);
    border-left-width: 3px;
    border-radius: 3px;
}

.card-title {
    -unity-font-style: bold;
}

.status-pill,
.count-pill {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 7px;
    border-radius: 9px;
    background-color: rgba(128, 128, 128, 0.18);
}

.count-pill {
    color: var(--unity-colors-secondary-text);
}

.status-info {
    color: rgb(92, 178, 239);
    background-color: rgba(72, 158, 222, 0.16);
}

.card-value {
    margin-top: 6px;
    -unity-font-style: bold;
}

.card-detail {
    margin-top: 3px;
    min-height: 30px;
}

.state-ready {
    border-left-color: rgb(55, 166, 104);
}

.state-ready .status-pill,
.status-ready {
    color: rgb(75, 190, 121);
}

.state-warning {
    border-left-color: rgb(218, 158, 46);
}

.state-warning .status-pill,
.status-warning {
    color: rgb(230, 170, 57);
}

.state-missing,
.state-error {
    border-left-color: rgb(210, 76, 76);
}

.state-missing .status-pill,
.state-error .status-pill,
.status-error {
    color: rgb(226, 92, 92);
}

.state-neutral {
    color: var(--unity-colors-secondary-text);
}

.details-grid {
    margin-top: 10px;
}

.detail-cell {
    flex-grow: 1;
    flex-basis: 28%;
    min-width: 190px;
    margin: 4px;
    padding: 8px 9px;
    border-radius: 3px;
    background-color: var(--unity-colors-default-background);
}

.detail-cell-wide {
    flex-basis: 45%;
}

.detail-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--unity-colors-secondary-text);
    margin-bottom: 2px;
}

.detail-value {
    white-space: normal;
}

.selectable-value {
    font-size: 10px;
}

.empty-state {
    align-items: center;
    padding: 18px 12px;
    margin-top: 9px;
    border-color: var(--unity-colors-border);
    border-width: 1px;
    border-radius: 3px;
}

.empty-title {
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.editor-name {
    -unity-font-style: bold;
    font-size: 13px;
}

.editor-path {
    white-space: normal;
    color: var(--unity-colors-secondary-text);
    font-size: 10px;
    margin-top: 3px;
    margin-bottom: 6px;
}

.editor-meta-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.editor-meta {
    min-width: 110px;
    flex-grow: 1;
    flex-basis: 45%;
    margin-top: 4px;
}

.editor-meta-value {
    font-size: 10px;
    white-space: normal;
}

.notices-container {
    margin-top: 8px;
}

.registration-banner,
.broker-card {
    padding: 9px 10px;
    margin-bottom: 8px;
    border-radius: 3px;
    background-color: var(--unity-colors-default-background);
}

.registration-name,
.metric-value {
    font-size: 14px;
    -unity-font-style: bold;
}

.broker-card {
    align-items: stretch;
    flex-wrap: wrap;
}

.broker-metric {
    min-width: 90px;
    padding-right: 18px;
    margin-right: 12px;
    border-right-color: var(--unity-colors-border);
    border-right-width: 1px;
}

.broker-policy {
    flex-grow: 1;
    min-width: 220px;
}

.button-primary {
    min-height: 30px;
    padding-left: 16px;
    padding-right: 16px;
    -unity-font-style: bold;
}

.button-secondary,
.button-danger {
    min-height: 24px;
}

.button-danger {
    color: rgb(226, 92, 92);
}

.button-link {
    align-self: flex-start;
    margin-left: -4px;
    margin-top: 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--unity-colors-link);
}

.card-actions,
.agent-controls {
    flex-direction: row;
    align-items: center;
}

.install-fallback {
    display: none;
}

.agent-row {
    min-width: 300px;
    flex-basis: 45%;
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 4px;
    padding: 7px 9px;
    background-color: var(--unity-colors-default-background);
    border-radius: 3px;
}

.agent-name {
    min-width: 112px;
    -unity-font-style: bold;
}

.agent-toggle {
    margin-left: 8px;
    margin-right: 4px;
}

.agent-detection {
    color: var(--unity-colors-secondary-text);
    font-size: 10px;
}

.agent-found,
.agent-on {
    color: rgb(75, 190, 121);
}

.agent-integration {
    min-width: 72px;
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
}

.agent-pending {
    color: rgb(72, 158, 222);
}

.agent-conflict {
    color: rgb(230, 170, 57);
}

.agent-toggle-value {
    min-width: 20px;
    font-size: 10px;
    -unity-font-style: bold;
}

.option-toggle {
    margin-top: 2px;
    margin-bottom: 5px;
}

.configuration-section {
    justify-content: space-between;
    flex-wrap: wrap;
}

.configuration-copy {
    margin-right: 14px;
}

.configuration-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
}

.configuration-actions > .unity-button {
    min-width: 150px;
    margin-left: 5px;
}

.review-button {
    min-width: 180px;
}

.preview-panel,
.result-panel,
.force-toggle,
.diagnostics-panel {
    display: none;
}

.changes-container {
    margin-top: 2px;
}

.change-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 7px 0;
    border-bottom-color: var(--unity-colors-border);
    border-bottom-width: 1px;
}

.change-kind {
    width: 58px;
    margin-right: 8px;
    font-size: 10px;
    -unity-font-style: bold;
}

.change-create {
    color: rgb(75, 190, 121);
}

.change-update,
.change-process {
    color: rgb(72, 158, 222);
}

.change-remove {
    color: rgb(226, 92, 92);
}

.change-description {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.warnings-container {
    margin-top: 8px;
}

.notice {
    white-space: normal;
    padding: 7px 9px;
    margin-bottom: 4px;
    border-radius: 3px;
}

.notice-warning {
    background-color: rgba(218, 158, 46, 0.16);
    color: rgb(230, 170, 57);
}

.notice-error {
    background-color: rgba(210, 76, 76, 0.14);
    color: rgb(226, 92, 92);
}

.notice-info {
    background-color: rgba(72, 158, 222, 0.13);
    color: rgb(92, 178, 239);
}

.force-toggle {
    margin-top: 8px;
    color: rgb(230, 170, 57);
}

.preview-actions {
    margin-top: 12px;
}

.preview-note {
    flex-grow: 1;
    margin-right: 12px;
    margin-bottom: 0;
}

.result-success {
    border-left-color: rgb(55, 166, 104);
    border-left-width: 4px;
}

.result-error {
    border-left-color: rgb(210, 76, 76);
    border-left-width: 4px;
}

.restart-container {
    margin-top: 7px;
}

.advanced {
    padding-top: 10px;
}

.advanced-group {
    margin-top: 9px;
    padding: 10px;
    background-color: var(--unity-colors-default-background);
    border-radius: 3px;
}

.advanced-row > .unity-button {
    margin-left: 6px;
}

.advanced-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
    margin-top: 7px;
}

.diagnostics-field {
    height: 170px;
    margin-top: 7px;
    white-space: normal;
}

.is-busy .button-primary,
.is-busy .button-secondary,
.is-busy .button-danger {
    opacity: 0.65;
}

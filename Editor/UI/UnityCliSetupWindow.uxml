<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:ScrollView name="setup-scroll" class="setup-scroll">
        <ui:VisualElement class="page">
            <ui:VisualElement class="hero">
                <ui:VisualElement class="hero-copy">
                    <ui:Label text="Unity CLI MCP" class="hero-title" />
                    <ui:Label text="Connect coding agents to this Unity project through Unity's official CLI." class="hero-subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="hero-actions">
                    <ui:Label name="page-status" text="Checking…" class="page-status" />
                    <ui:Button name="refresh-status" text="Refresh" tooltip="Refresh readiness without changing configuration" class="button-secondary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="section compact-section">
                <ui:Label text="Readiness" class="section-title" />
                <ui:VisualElement class="readiness-row">
                    <ui:VisualElement name="cli-card" class="readiness-card">
                        <ui:VisualElement name="cli-lamp" class="status-lamp" />
                        <ui:VisualElement class="readiness-copy">
                            <ui:Label text="Unity CLI" class="card-title" />
                            <ui:Label name="cli-detail" text="Checking…" class="card-detail" />
                            <ui:Label name="cli-reason" text="" class="disabled-reason" />
                        </ui:VisualElement>
                        <ui:Button name="install-cli" text="Install" class="button-primary button-compact" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pipeline-card" class="readiness-card">
                        <ui:VisualElement name="pipeline-lamp" class="status-lamp" />
                        <ui:VisualElement class="readiness-copy">
                            <ui:Label text="Pipeline" class="card-title" />
                            <ui:Label name="pipeline-detail" text="Checking…" class="card-detail" />
                            <ui:Label name="pipeline-reason" text="" class="disabled-reason" />
                        </ui:VisualElement>
                        <ui:Button name="install-pipeline" text="Install" class="button-primary button-compact" />
                    </ui:VisualElement>
                    <ui:VisualElement name="editor-card" class="readiness-card">
                        <ui:VisualElement name="editor-lamp" class="status-lamp" />
                        <ui:VisualElement class="readiness-copy">
                            <ui:Label text="This Editor" class="card-title" />
                            <ui:Label name="editor-detail" text="Checking…" class="card-detail" />
                            <ui:Label name="editor-reason" text="" class="disabled-reason" />
                        </ui:VisualElement>
                        <ui:Button name="start-pipeline" text="Start Pipeline" class="button-primary button-compact" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="official-mcp-card" class="section official-mcp-card">
                <ui:VisualElement class="mcp-card-header">
                    <ui:VisualElement name="official-mcp-lamp" class="status-lamp status-lamp-large" />
                    <ui:VisualElement class="mcp-card-copy">
                        <ui:Label text="Official Unity stdio MCP" class="section-title" />
                        <ui:Label text="The agent starts this process when it connects. There is no server to start here." class="section-description" />
                    </ui:VisualElement>
                    <ui:Label name="official-mcp-state" text="Not ready" class="status-pill state-neutral" />
                </ui:VisualElement>
                <ui:Label name="official-mcp-detail" text="Complete readiness checks before testing." class="mcp-result" />
                <ui:Button name="test-official-mcp" text="Test MCP" tooltip="Launch Unity CLI stdio, initialize MCP, then request tools/list" class="button-primary button-large" />
                <ui:Label name="test-official-mcp-reason" text="" class="disabled-reason" />
            </ui:VisualElement>

            <ui:VisualElement class="section">
                <ui:VisualElement class="section-heading-row">
                    <ui:VisualElement>
                        <ui:Label text="Agents" class="section-title" />
                        <ui:Label text="Detected agents are shown first." class="section-description" />
                    </ui:VisualElement>
                    <ui:Button name="show-all-agents" text="Show all" class="button-secondary button-compact" />
                </ui:VisualElement>
                <ui:VisualElement name="agents-container" class="cards-list" />
                <ui:Label name="agents-empty" text="No supported agents detected." class="empty-detail" />
            </ui:VisualElement>

            <ui:VisualElement class="section">
                <ui:Label text="Skills" class="section-title" />
                <ui:Label text="Optional workflow guidance installed for your agents." class="section-description" />
                <ui:VisualElement name="skills-container" class="skill-grid" />
            </ui:VisualElement>

            <ui:VisualElement name="result-panel" class="section result-panel">
                <ui:Label name="result-title" text="" class="card-title" />
                <ui:Label name="result-details" text="" class="result-details" />
            </ui:VisualElement>

            <ui:Foldout name="advanced-foldout" text="Advanced" value="false" class="advanced">
                <ui:Label text="Custom broker, loopback HTTP, recovery, and sanitized diagnostics." class="section-description" />
                <ui:VisualElement class="advanced-group">
                    <ui:VisualElement class="section-heading-row">
                        <ui:VisualElement>
                            <ui:Label text="Custom broker / HTTP" class="card-title" />
                            <ui:Label name="broker-status" text="Stopped" class="card-detail" />
                        </ui:VisualElement>
                        <ui:Button name="http-action" text="Start HTTP" class="button-secondary" />
                    </ui:VisualElement>
                    <uie:IntegerField name="http-port" label="Preferred port (0 = automatic)" value="0" />
                    <ui:Label name="http-disabled-reason" text="" class="disabled-reason" />
                </ui:VisualElement>
                <ui:VisualElement class="advanced-group">
                    <ui:Label text="Recovery" class="card-title" />
                    <ui:VisualElement class="advanced-row">
                        <ui:Button name="remove-configuration" text="Remove managed data" class="button-danger" />
                        <ui:Button name="rollback-configuration" text="Rollback latest backup" class="button-secondary" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="advanced-group">
                    <ui:VisualElement class="section-heading-row">
                        <ui:Label text="Sanitized diagnostics" class="card-title" />
                        <ui:Button name="copy-diagnostics" text="Copy" class="button-secondary button-compact" />
                    </ui:VisualElement>
                    <ui:TextField name="diagnostics" label="Diagnostic log" multiline="true" is-read-only="true" class="diagnostics-field" />
                </ui:VisualElement>
            </ui:Foldout>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
